        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">20dp</item>
    </style>
    <style name="Widget.TimeReclaimer.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
